# Railway deployment profile for NAP-ML-Service.
# Copy to .env and fill in values, or set these as Railway service variables.

# Base URL of the NAP Spring backend that serves the CMS content APIs.
# Local development:
NAP_BASE_URL=http://localhost:8080
# Railway (private networking, same project):
# NAP_BASE_URL=http://backend.railway.internal:8080

# Embedding model identifier.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning.
CHUNK_SIZE=1600
CHUNK_OVERLAP=160
TOP_K_DEFAULT=5
ANSWER_CHUNK_LIMIT=1200

# Fallback display name used in generated answers when a tenant has not set
# ``portal_name`` in the CMS. Keep this generic; the real name comes from the
# admin Settings page.
PORTAL_NAME=our university

# Public base URL of the site. When set, chat answers append a "read more"
# markdown link to each cited source (programmes deep-link to /programs/:id;
# other collections link to their listing page). Leave unset to disable links
# and keep the offline evaluation baseline unchanged.
# SITE_LINK_BASE=https://portal.example.com

# Optional contact overrides for "who can I contact?" answers. Leave these unset
# to use the CMS values (footer_email / footer_phone / footer_address from
# /api/v1/content/site-settings) with the front-end fallbacks. Set them only if
# contact details are kept out of the database.
# CONTACT_EMAIL=admissions@example.edu
# CONTACT_PHONE=+256 700 000 000
# CONTACT_WHATSAPP=+256 700 000 000
# CONTACT_ADDRESS=Plot 7, Nakawa Road, Kampala, Uganda
# CONTACT_HOURS=Monday-Friday, 8:00 AM - 5:00 PM

# Where the built index is written. Point this at a mounted volume so the
# index survives restarts and redeploys; without one the container starts
# empty on every deploy and rebuilds at startup. Each tenant gets its own
# subdirectory (data/indices/tenants/<code>), so one volume holds them all.
# Railway: create a volume mounted at /data and use ML_DATA_DIR=/data
ML_DATA_DIR=./data

# Tenant reference that maps to the deployment default knowledge base, so the
# startup trainer and the default tenant's chat requests share one index.
# TENANT_DEFAULT_CODE should match the backend's TENANT_DEFAULT_CODE (e.g.
# demo). TENANT_DEFAULT_ID matches the backend's default tenant id (1). Leave
# both at their defaults for a single-tenant deployment.
TENANT_DEFAULT_CODE=demo
TENANT_DEFAULT_ID=1

# Build the index at startup when none exists (recommended with a volume).
AUTO_TRAIN_ON_STARTUP=true
AUTO_TRAIN_ATTEMPTS=3
AUTO_TRAIN_BACKOFF_SECONDS=10

# Shared secret required by POST /api/train and GET /api/sources.
# Required in production: the endpoints fail closed with 503 when it is unset.
# Must match ML_SERVICE_ADMIN_TOKEN on the NAP-Backend service.
ML_ADMIN_TOKEN=change-me

# Shared secret sent as X-Internal-Token when fetching tenant content from the
# backend, so the backend lets this service select a tenant with X-Tenant.
# Must match INTERNAL_API_TOKEN (nap.tenancy.internal-token) on NAP-Backend.
INTERNAL_API_TOKEN=change-me-too