# Frontend URLs
# Public issuer for Nexus Identity.
VITE_IDENTITY_ISSUER=http://localhost:9000
# Local NU-Backend.
VITE_API_BASE_URL=http://localhost:8081
VITE_NU_API_BASE_URL=http://localhost:8081
# Lecturer messaging backend.
VITE_WEBMAIL_API_BASE_URL=http://localhost:8084
# Registrar backend.
VITE_REG_API_BASE_URL=http://localhost:8082
# Local NAD Admissions Dashboard backend (admissions-server).
VITE_NAD_API_BASE_URL=http://localhost:8083
# Points to the NAP Nexus Application Portal backend. This is the auth provider
# for /auth and /forgot-password: it owns applicant credentials and the
# admission decision, so student login only succeeds once status is ADMITTED.
# Do not point this at NU-Backend -- its student auth route returns HTTP 410.
VITE_ADMISSIONS_API_BASE_URL=http://localhost:8080